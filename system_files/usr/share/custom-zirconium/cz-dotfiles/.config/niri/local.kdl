input {
  keyboard {
    repeat-delay 200
    xkb {
      layout "de"
      options "caps:escape" // Make caps act like escape
    }
  }
}

binds {
  Mod+B { spawn "zen-browser"; }
  // German keyboard can't type Mod+Slash
  Mod+Shift+Slash { show-hotkey-overlay; }
}

window-rule {
  match app-id="^foot$"

  background-effect {
    blur true
  }
}

window-rule {
  match app-id="^kitty$"

  background-effect {
    blur true
  }
}
