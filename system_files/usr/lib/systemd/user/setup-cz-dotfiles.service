[Unit]
Description=Installs custom-zirconium specific dotfiles
ConditionPathExists=!%h/.config/niri/local.kdl

[Service]
Environment="DOTFILE_PATH=/usr/share/custom-zirconium/cz-dotfiles"
Environment="ZDOTS_DMS_SETTINGS=/usr/share/zirconium/zdots/dot_config/DankMaterialShell/settings.json"
Environment="CUSTOM_DOTS_DMS_SETTINGS=/usr/share/custom-zirconium/cz-dotfiles/.config/DankMaterialShell/settings-patch.json"
Environment="ZDOTS_DMS_SESSION=/usr/share/zirconium/zdots/private_dot_local/state/DankMaterialShell/session.json"
Environment="CUSTOM_DOTS_DMS_SESSION=/usr/share/custom-zirconium/cz-dotfiles/.local/state/DankMaterialShell/session-patch.json"
ExecStart=sh -c 'ln -s "$DOTFILE_PATH/.config/niri/local.kdl" "%h/.config/niri/local.kdl"'
# This will path the zdots DMS settings.json with the custom patch
ExecStart=yq -n 'load(strenv(ZDOTS_DMS_SETTINGS)) * load(strenv(CUSTOM_DOTS_DMS_SETTINGS))' --prettyPrint -o json >> "$ZDOTS_DMS_SETTINGS"
# This will path the zdots DMS session.json with the custom patch
ExecStart=yq -n 'load(strenv(ZDOTS_DMS_SETTINGS)) * load(strenv(CUSTOM_DOTS_DMS_SETTINGS))' --prettyPrint -o json >> "$ZDOTS_DMS_SETTINGS"
Type=oneshot
RemainAfterExit=true

[Install]
WantedBy=graphical-session-pre.target
